APP_LOGIN_USERNAME=JARWINN
APP_LOGIN_PASSWORD=change-this-password

SOLIS_API_KEY=
SOLIS_API_SECRET=
SOLIS_API_URL=https://www.soliscloud.com:13333
MONITORING_USE_NATIVE_SOLIS=false
MONITORING_API_BASE_URL=
MONITORING_API_BASE_URLS=
MONITORING_API_MOBILE_LOCAL_FIRST=false

HUAWEI_BASE_URL=
HUAWEI_USERNAME=
HUAWEI_SYSTEM_CODE=

GROWATT_BASE_URL=https://openapi.growatt.com
GROWATT_API_TOKEN=

# Firebase Cloud Messaging (server-side HTTP v1)
# Store the service-account JSON outside the public web root.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_FILE=/secure/path/firebase-service-account.json
FIREBASE_PUSH_TOPIC=solarview-alerts
PUSH_CRON_SECRET=replace-with-a-long-random-secret
INCIDENT_STORE_FILE=/secure/path/solarview-incidents.json
# Minimum interval for repeated issue notifications for the same plant.
PUSH_NOTIFICATION_COOLDOWN_SECONDS=900
